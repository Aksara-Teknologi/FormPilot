# Non-secret model configuration
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Store these as Worker secrets in production
OPENAI_API_KEY=
MCP_AUTH_TOKEN=
APP_SIGNING_SECRET=
GOOGLE_CLIENT_SECRET=

# Remote MCP Streamable HTTP endpoint and permitted form domains
MCP_SERVER_URL=https://mcp.example.com/mcp
MCP_INSPECT_TOOL=inspect_form
MCP_FILL_TOOL=fill_form
# Opsional. Kosong berarti semua target HTTPS; isi hostname dipisahkan koma untuk mode allowlist.
ALLOWED_TARGET_HOSTS=

# Google OAuth Web client. Restriksi domain bersifat opsional.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_DOMAINS=
