{
  "name": "formpilot",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm audit --omit=dev --audit-level=high",
    "db:generate": "drizzle-kit generate",
    "release:config": "node scripts/prepare-cloudflare-deploy.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:package": "bash scripts/package-release.sh"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.5",
    "next": "^16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "read-excel-file": "^9.3.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@cloudflare/workers-types": "^5.20260728.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.32",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.0",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "0.2.1",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  },
  "type": "module"
}
